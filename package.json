{
  "name": "nusuk-request-handler",
  "version": "1.0.0",
  "type": "module",
  "description": "Authenticated Nusuk API request CLI and Node.js client",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check bin/nusuk.js && node --check src/*.js && node --check reqTook.js && node --check senReq.js",
    "container": "node src/server.js",
    "dev": "next dev",
    "dev:worker": "npx wrangler dev",
    "build": "next build",
    "start": "next start",
    "deploy": "./scripts/deploy.sh",
    "deploy:dev": "./scripts/deploy.sh --dev",
    "deploy:build-only": "./scripts/deploy.sh --build-only",
    "deploy:rollback": "./scripts/deploy.sh --rollback",
    "containers:list": "npx wrangler containers list",
    "containers:images": "npx wrangler containers images list",
    "containers:ssh": "npx wrangler containers ssh",
    "setup:auth": "./scripts/setup-access-oauth.sh"
  },
  "bin": {
    "nusuk": "./bin/nusuk.js"
  },
  "exports": {
    ".": "./src/nusuk.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@captcha-libs/capsolver": "^2.2.0",
    "@cloudflare/containers": "^0.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@zennolab_com/capmonstercloud-client": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "cloakbrowser": "^0.5.6",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "jose": "^6.2.8",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "playwright-core": "^1.62.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.17.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "typescript": "7.0.2",
    "wrangler": "^4.120.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260801.1": true
  },
  "overrides": {
    "undici": "^7.29.0"
  }
}
