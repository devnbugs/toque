{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toque",
  "main": "src/index.js",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "WORKER_URL": "https://autha-worker.decloud.workers.dev"
  },
  "secrets": {
    "required": ["WORKER_API_TOKEN"]
  },
  "placement": {
    "mode": "smart"
  },
  "containers": [
    {
      "class_name": "ToqueContainer",
      "image": "registry.cloudflare.com/3943d4ec18c5391fbbe9158a5d629b55/toque:7208a0b",
      "instance_type": {
        "vcpu": 4,
        "memory_mib": 12288,
        "disk_mb": 20000
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TOQUE_CONTAINER",
        "class_name": "ToqueContainer"
      }
    ]
  },
  "workflows": [
    {
      "name": "visa-schedule",
      "binding": "VISA_SCHEDULE_WORKFLOW",
      "class_name": "VisaScheduleWorkflow"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ToqueContainer"]
    }
  ]
}
