{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toque",
  "main": "src/index.js",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "vars": {
    "WORKER_URL": "https://autha-worker.decloud.workers.dev",
    "TOQUE_WORKER_URL": "https://toque.decloud.workers.dev"
  },
  "services": [
    {
      "binding": "AUTHA_WORKER",
      "service": "autha-worker"
    }
  ],
  "placement": {
    "mode": "targeted",
    "region": "aws:eu-central-1"
  },
  "preview_urls": false,
  "containers": [
    {
      "class_name": "ToqueContainer",
      "image": "registry.cloudflare.com/3943d4ec18c5391fbbe9158a5d629b55/toque:f31d238",
      "instance_type": "standard-4",
      "max_instances": 1,
      "constraints": {
        "regions": [
          "WEUR",
          "EEUR"
        ]
      },
      "ssh": {
        "enabled": true
      },
      "authorized_keys": [
        {
          "name": "toque-admin",
          "public_key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJz83jY18H/w0eg5powOZjK8PALdKpckiqOWGtGOsfAp toque-admin"
        },
        {
          "name": "rhsalisu",
          "public_key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJz83jY18H/w0eg5powOZjK8PALdKpckiqOWGtGOsfAp rhsalisu@DeCore"
        }
      ]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TOQUE_CONTAINER",
        "class_name": "ToqueContainer"
      }
    ]
  },
  "workflows": [
    {
      "name": "visa-schedule",
      "binding": "VISA_SCHEDULE_WORKFLOW",
      "class_name": "VisaScheduleWorkflow"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ToqueContainer"
      ]
    }
  ]
}
