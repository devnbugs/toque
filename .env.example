# Autha D1 Worker
# In direct mode, WORKER_URL points at the autha-worker and WORKER_API_TOKEN
# is required. In proxy mode (container), AUTHA_PROXY_URL points at the toque
# Worker's /autha service-binding proxy and WORKER_API_TOKEN is not needed.
WORKER_URL=https://authad.vortex.name.ng
WORKER_API_TOKEN=
AUTHA_PROXY_URL=
SYSTEM_USER_ID=

# Automatically captured entity overrides (optional)
ACTIVE_ENTITY_ID=
ACTIVE_ENTITY_TYPE_ID=

# Local credential/config paths
AUTH_PATH=auth.json
CAPTCHA_PATH=captcha.json
ENTITY_CONFIG_PATH=entity.json

# Used only by `nusuk captcha-set`
CAPTCHA_TOKEN=

# Optional JSON payload/headers used by senReq.js
MASAR_POST_BODY=
MASAR_POST_HEADERS=